{
  "name": "synexis-sign-mcp",
  "version": "1.0.0",
  "description": "MCP server for Synexis Sign — agents interact with templates, submissions, contacts, and webhooks via the REST API",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "synexis-mcp": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
